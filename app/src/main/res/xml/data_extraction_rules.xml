<?xml version="1.0" encoding="utf-8"?>
<!-- TrueStep Data Extraction Rules (Android 12+ / API 31+) -->
<data-extraction-rules>
    <cloud-backup>
        <!-- Include local database and DataStore preferences across cloud backups -->
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
        <include domain="file" path="datastore" />
    </cloud-backup>
    <device-transfer>
        <!-- Include local database and DataStore preferences across device-to-device transfers -->
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
        <include domain="file" path="datastore" />
    </device-transfer>
</data-extraction-rules>
